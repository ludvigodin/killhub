{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://killhub.dev/schemas/detonation_verdict.v1.json",
  "title": "Killhub Detonation Verdict (v1)",
  "description": "Canonical Plane 1 Detonation Verdict JSON persisted in JobReceipt and returned by GET /api/jobs/{id}/verdict, covering target integrity hashes, verdict, 4-axis containment proof + key isolation, MCP capability diffs, findings, full 16 MITRE ATLAS tactic coverage, full 10 OWASP MCP Top 10 coverage, and telemetry counters (R4, DECISIONS.md D47-D49, D58, D66, D70-D73).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scan_id",
    "target",
    "verdict",
    "containment_proof",
    "mcp_capabilities",
    "findings",
    "atlas_coverage_matrix",
    "owasp_mcp_coverage",
    "telemetry"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "scan_id": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "locator",
        "resolved_ref",
        "package_sha256_before",
        "package_sha256_after",
        "integrity_tampered"
      ],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": ["github_repo", "git_repo", "npm_package", "pypi_package", "fixture"]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "resolved_ref": {
          "type": ["string", "null"],
          "minLength": 1,
          "description": "Null when the job stopped before source resolution."
        },
        "package_sha256_before": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$",
          "description": "Baseline artifact digest. For git targets this covers files tracked by the pinned commit. Null when unavailable."
        },
        "package_sha256_after": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$",
          "description": "The same artifact scope after install. Null when unavailable."
        },
        "integrity_tampered": {
          "type": ["boolean", "null"],
          "description": "True when the artifact bytes or tracked entries differ. Null when a comparable pair is unavailable."
        }
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "risk_score", "summary", "kill_switch_triggered"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["CLEAN", "SUSPICIOUS", "MALICIOUS", "ABORTED", "INCONCLUSIVE"]
        },
        "risk_score": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "kill_switch_triggered": {
          "type": "object",
          "additionalProperties": false,
          "required": ["triggered", "layer", "reason", "timestamp"],
          "properties": {
            "triggered": { "type": "boolean" },
            "layer": {
              "type": ["string", "null"],
              "enum": ["layer1_llm_proxy", "layer2_cgroup_v2", "layer3_watchdog", null]
            },
            "reason": { "type": ["string", "null"] },
            "timestamp": { "type": ["string", "null"], "format": "date-time" }
          },
          "allOf": [
            {
              "if": {
                "properties": { "triggered": { "const": false } },
                "required": ["triggered"]
              },
              "then": {
                "properties": { "layer": { "const": null } }
              }
            },
            {
              "if": {
                "properties": { "triggered": { "const": true } },
                "required": ["triggered"]
              },
              "then": {
                "properties": {
                  "layer": {
                    "type": "string",
                    "enum": ["layer1_llm_proxy", "layer2_cgroup_v2", "layer3_watchdog"]
                  }
                }
              }
            }
          ]
        }
      }
    },
    "containment_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_enforcement",
        "host_access_denied",
        "sibling_access_denied",
        "host_liveness",
        "claim",
        "key_isolation_verified",
        "canary_blocking_verified",
        "doh_dot_quic_dropped"
      ],
      "properties": {
        "timeout_enforcement": {
          "$ref": "#/$defs/ContainmentAxisResult"
        },
        "host_access_denied": {
          "$ref": "#/$defs/ContainmentAxisResult"
        },
        "sibling_access_denied": {
          "$ref": "#/$defs/ContainmentAxisResult"
        },
        "host_liveness": {
          "$ref": "#/$defs/ContainmentAxisResult"
        },
        "claim": {
          "type": "string",
          "enum": ["complete", "incomplete"]
        },
        "key_isolation_verified": {
          "type": "boolean",
          "description": "True when VULTR_INFERENCE_API_KEY was verified absent from guest env/proc/files and Plane 2 OpenCode routed via Host LLM Proxy."
        },
        "canary_blocking_verified": {
          "type": "boolean"
        },
        "doh_dot_quic_dropped": {
          "type": "boolean"
        }
      }
    },
    "mcp_capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discovery_method",
        "t0_tools_sha256",
        "final_tools_sha256",
        "tool_diffs",
        "tools_count_t0",
        "tools_count_final",
        "resources_count",
        "prompts_count"
      ],
      "properties": {
        "discovery_method": {
          "type": "string",
          "enum": ["mcp_inspector_cli", "python_mcp_sdk_fallback", "none"]
        },
        "t0_tools_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "final_tools_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "tool_diffs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tool_name", "change_type"],
            "properties": {
              "tool_name": { "type": "string", "minLength": 1 },
              "change_type": {
                "type": "string",
                "enum": ["added", "removed", "modified_schema", "modified_description"]
              },
              "t0_sha256": {
                "type": ["string", "null"],
                "pattern": "^[a-f0-9]{64}$"
              },
              "final_sha256": {
                "type": ["string", "null"],
                "pattern": "^[a-f0-9]{64}$"
              },
              "detail": { "type": "string" }
            }
          }
        },
        "tools_count_t0": { "type": "integer", "minimum": 0 },
        "tools_count_final": { "type": "integer", "minimum": 0 },
        "resources_count": { "type": "integer", "minimum": 0 },
        "prompts_count": { "type": "integer", "minimum": 0 }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DetonationFinding"
      }
    },
    "atlas_coverage_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "AML.TA0000",
        "AML.TA0001",
        "AML.TA0002",
        "AML.TA0003",
        "AML.TA0004",
        "AML.TA0005",
        "AML.TA0006",
        "AML.TA0007",
        "AML.TA0008",
        "AML.TA0009",
        "AML.TA0010",
        "AML.TA0011",
        "AML.TA0012",
        "AML.TA0013",
        "AML.TA0014",
        "AML.TA0015"
      ],
      "properties": {
        "AML.TA0000": { "$ref": "#/$defs/AtlasCoverageEntry" },
        "AML.TA0001": { "$ref": "#/$defs/AtlasCoverageEntry" },
        "AML.TA0002": { "$ref": "#/$defs/AtlasCoverageEntry" },
        "AML.TA0003": { "$ref": "#/$defs/AtlasCoverageEntry" },
        "AML.TA0004": { "$ref": "#/$defs/AtlasCoverageEntry" },
        "AML.TA0005": { "$ref": "#/$defs/AtlasCoverageEntry" },
        "AML.TA0006": { "$ref": "#/$defs/AtlasCoverageEntry" },
        "AML.TA0007": { "$ref": "#/$defs/AtlasCoverageEntry" },
        "AML.TA0008": { "$ref": "#/$defs/AtlasCoverageEntry" },
        "AML.TA0009": { "$ref": "#/$defs/AtlasCoverageEntry" },
        "AML.TA0010": { "$ref": "#/$defs/AtlasCoverageEntry" },
        "AML.TA0011": { "$ref": "#/$defs/AtlasCoverageEntry" },
        "AML.TA0012": { "$ref": "#/$defs/AtlasCoverageEntry" },
        "AML.TA0013": { "$ref": "#/$defs/AtlasCoverageEntry" },
        "AML.TA0014": { "$ref": "#/$defs/AtlasCoverageEntry" },
        "AML.TA0015": { "$ref": "#/$defs/AtlasCoverageEntry" }
      }
    },
    "owasp_mcp_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "MCP01:2025",
        "MCP02:2025",
        "MCP03:2025",
        "MCP04:2025",
        "MCP05:2025",
        "MCP06:2025",
        "MCP07:2025",
        "MCP08:2025",
        "MCP09:2025",
        "MCP10:2025"
      ],
      "properties": {
        "MCP01:2025": { "$ref": "#/$defs/OwaspMcpCoverageEntry" },
        "MCP02:2025": { "$ref": "#/$defs/OwaspMcpCoverageEntry" },
        "MCP03:2025": { "$ref": "#/$defs/OwaspMcpCoverageEntry" },
        "MCP04:2025": { "$ref": "#/$defs/OwaspMcpCoverageEntry" },
        "MCP05:2025": { "$ref": "#/$defs/OwaspMcpCoverageEntry" },
        "MCP06:2025": { "$ref": "#/$defs/OwaspMcpCoverageEntry" },
        "MCP07:2025": { "$ref": "#/$defs/OwaspMcpCoverageEntry" },
        "MCP08:2025": { "$ref": "#/$defs/OwaspMcpCoverageEntry" },
        "MCP09:2025": { "$ref": "#/$defs/OwaspMcpCoverageEntry" },
        "MCP10:2025": { "$ref": "#/$defs/OwaspMcpCoverageEntry" }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "http_requests",
        "https_intercepted",
        "dns_queries",
        "doh_dot_quic_blocked",
        "canary_blocks",
        "strace_syscalls_flagged",
        "overlayfs_modified_paths",
        "mcp_wire_messages",
        "cgroup_events",
        "llm_proxy_turns",
        "llm_proxy_tokens",
        "llm_proxy_429_blocks",
        "pcap_artifact_path",
        "ndjson_events_count"
      ],
      "properties": {
        "http_requests": { "type": "integer", "minimum": 0 },
        "https_intercepted": { "type": "integer", "minimum": 0 },
        "dns_queries": { "type": "integer", "minimum": 0 },
        "doh_dot_quic_blocked": { "type": "integer", "minimum": 0 },
        "canary_blocks": { "type": "integer", "minimum": 0 },
        "strace_syscalls_flagged": { "type": "integer", "minimum": 0 },
        "overlayfs_modified_paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "mcp_wire_messages": { "type": "integer", "minimum": 0 },
        "cgroup_events": {
          "type": "object",
          "additionalProperties": false,
          "required": ["oom", "pid_max", "cpu_throttled"],
          "properties": {
            "oom": { "type": "integer", "minimum": 0 },
            "pid_max": { "type": "integer", "minimum": 0 },
            "cpu_throttled": { "type": "integer", "minimum": 0 }
          }
        },
        "llm_proxy_turns": { "type": "integer", "minimum": 0 },
        "llm_proxy_tokens": { "type": "integer", "minimum": 0 },
        "llm_proxy_429_blocks": { "type": "integer", "minimum": 0 },
        "pcap_artifact_path": { "type": ["string", "null"] },
        "ndjson_events_count": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "AtlasTacticId": {
      "type": "string",
      "enum": [
        "AML.TA0000",
        "AML.TA0001",
        "AML.TA0002",
        "AML.TA0003",
        "AML.TA0004",
        "AML.TA0005",
        "AML.TA0006",
        "AML.TA0007",
        "AML.TA0008",
        "AML.TA0009",
        "AML.TA0010",
        "AML.TA0011",
        "AML.TA0012",
        "AML.TA0013",
        "AML.TA0014",
        "AML.TA0015"
      ]
    },
    "OwaspMcpId": {
      "type": "string",
      "enum": [
        "MCP01:2025",
        "MCP02:2025",
        "MCP03:2025",
        "MCP04:2025",
        "MCP05:2025",
        "MCP06:2025",
        "MCP07:2025",
        "MCP08:2025",
        "MCP09:2025",
        "MCP10:2025"
      ]
    },
    "SensorId": {
      "type": "string",
      "enum": [
        "mitmdump_http",
        "mitmdump_dns",
        "tcpdump_pcap",
        "strace",
        "overlayfs",
        "checkout_sha256",
        "mcp_wire_tap",
        "cgroup_v2",
        "llm_proxy",
        "canary_monitor",
        "inspector_diff",
        "opencode_db_audit",
        "hypervisor_watchdog",
        "sca_scanner",
        "preflight"
      ]
    },
    "ContainmentAxisResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "detail"],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "policy_denied",
            "failed",
            "infra_error",
            "tooling_missing",
            "inconclusive",
            "not_tested"
          ]
        },
        "positive_control_passed": { "type": ["boolean", "null"] },
        "detail": { "type": "string" }
      }
    },
    "DetonationFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "source",
        "atlas_tactic",
        "owasp_mcp",
        "sensor",
        "title",
        "detail",
        "evidence",
        "blocked",
        "cited_by_review"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "severity": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low", "info"]
        },
        "source": {
          "type": "string",
          "enum": [
            "sca",
            "mcp_assessment",
            "intentional_app",
            "canary",
            "network",
            "containment",
            "preflight",
            "runtime_sensor",
            "kill_switch"
          ]
        },
        "atlas_tactic": {
          "anyOf": [
            { "$ref": "#/$defs/AtlasTacticId" },
            { "type": "null" }
          ]
        },
        "owasp_mcp": {
          "anyOf": [
            { "$ref": "#/$defs/OwaspMcpId" },
            { "type": "null" }
          ]
        },
        "sensor": {
          "anyOf": [
            { "$ref": "#/$defs/SensorId" },
            { "type": "null" }
          ]
        },
        "title": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "object",
          "additionalProperties": true
        },
        "blocked": { "type": "boolean" },
        "cited_by_review": { "type": "boolean" }
      }
    },
    "AtlasCoverageEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tactic_id", "tactic_name", "monitored", "sensors", "triggered", "finding_ids"],
      "properties": {
        "tactic_id": { "$ref": "#/$defs/AtlasTacticId" },
        "tactic_name": { "type": "string", "minLength": 1 },
        "monitored": { "type": "boolean" },
        "sensors": {
          "type": "array",
          "items": { "$ref": "#/$defs/SensorId" }
        },
        "triggered": { "type": "boolean" },
        "finding_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "OwaspMcpCoverageEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category_id", "name", "monitored", "sensors", "triggered", "finding_ids"],
      "properties": {
        "category_id": { "$ref": "#/$defs/OwaspMcpId" },
        "name": { "type": "string", "minLength": 1 },
        "monitored": { "type": "boolean" },
        "sensors": {
          "type": "array",
          "items": { "$ref": "#/$defs/SensorId" }
        },
        "triggered": { "type": "boolean" },
        "finding_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

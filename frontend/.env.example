# Copy to `.env.local` for `pnpm dev` (Next.js does not load the repo-root `.env`).
INTERNAL_API_TOKEN=change-me-local-only
EXPLORE_BASE_URL=http://127.0.0.1:8100
# Optional: public metadata for the nav star count when the repo is private.
# Fine-grained token with metadata read is enough; omit once the repo is public.
GITHUB_TOKEN=

# Killhub Plane 1 — copy to `.env` and fill in. Never commit real secrets.
# Sandboxes get canaries only — do not inject these into Plane 2 (D44).

# --- Next.js ↔ explore (D52) ---
INTERNAL_API_TOKEN=change-me-local-only
EXPLORE_BASE_URL=http://explore:8100
# Default loopback; docker-compose overrides to 0.0.0.0 for the internal network.
EXPLORE_HOST=127.0.0.1
EXPLORE_PORT=8100
SSE_KEEPALIVE_SECONDS=15
WORKER_POLL_SECONDS=1

# --- Vultr ---
VULTR_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_MODEL=

# --- OpenCode (trusted config only — D38; Vultr inference only — D25) ---
# Empty → explore/opencode/opencode.json (host-owned). Never point at a submitted repo.
OPENCODE_CONFIG=
OPENCODE_MODEL=

# --- Microsandbox / VX1 harness (D36, D39, D59) ---
# Empty / local = msb on PATH. Otherwise SSH target (user@host) for remote VX1.
MSB_HOST=
# Absolute path when SSH'ing (remote non-login PATH often lacks ~/.local/bin).
MSB_BIN=msb
MSB_SSH_KEY=
MSB_DEFAULT_IMAGE=debian
MSB_DEFAULT_CPUS=2
MSB_DEFAULT_MEMORY=4Gi
MSB_NET_POLICY=
# Comma-separated hostnames/IPs denied on every sandbox create (D39).
CONTROL_PLANE_DENY_HOSTS=
MSB_READY_TIMEOUT_SECONDS=120
MSB_AUTO_CREATE=false
REAPER_ENABLED=true
REAPER_POLL_SECONDS=30
CANARY_STORAGE=./storage/canaries

# --- Plane-1 pre-flight (D45) ---
PREFLIGHT_ENABLED=true
# Comma list: org/repo, org/*, or org
PREFLIGHT_DENY_REPOS=
PREFLIGHT_GITHUB_API=https://api.github.com
PREFLIGHT_TIMEOUT_SECONDS=5
PREFLIGHT_SOFT_MAX_SIZE_KB=500000
# Optional GitHub token for higher metadata rate limits (Plane 1 only).
GITHUB_TOKEN=

# --- Timeouts / admission / budgets (D40, D41) ---
JOB_TIMEOUT_SECONDS=3600
ENV_TTL_SECONDS=7200
MAX_REPAIR_ATTEMPTS=3
MAX_CONCURRENT_JOBS=2
MAX_QUEUED_JOBS=8
MAX_JOB_LOG_BYTES=2000000
MAX_SCREENSHOTS_PER_JOB=12
INFERENCE_BUDGET_TOKENS_PER_JOB=200000
INFERENCE_BUDGET_REJECT=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_POST_JOBS_PER_IP=10
RATE_LIMIT_POST_JOBS_GLOBAL=60

# --- Ledger / artifacts (D41, D60) ---
LEDGER_URL=sqlite:///./storage/ledger/killhub.db
SCREENSHOT_STORAGE=./storage/screenshots
ARTIFACT_STORAGE=./storage/artifacts
HELPERS_ROOT=./helpers
MSB_STAGE_DIR=/tmp/killhub-stage
MAX_COPY_BYTES=32000000
MSB_EXEC_TIMEOUT_SECONDS=120

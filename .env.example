# Killhub Plane 1 — copy to `.env` and fill in. Never commit real secrets.
# Sandboxes get canaries only — do not inject these into Plane 2 (D44).

# --- Next.js ↔ explore (D52) ---
INTERNAL_API_TOKEN=change-me-local-only
# Local / pnpm: http://127.0.0.1:8100 (also set in frontend/.env.local). docker-compose overrides to http://explore:8100.
EXPLORE_BASE_URL=http://127.0.0.1:8100
# Default loopback; docker-compose overrides to 0.0.0.0 for the internal network.
EXPLORE_HOST=127.0.0.1
EXPLORE_PORT=8100
SSE_KEEPALIVE_SECONDS=15
WORKER_POLL_SECONDS=1

# --- Operator MCP (D81) — stdio client + explore HTTP /internal/mcp tool egress ---
# Origin of the public Jobs API (Next.js edge). Not the explore sidecar URL.
# Required on VX1/explore when serving POST /mcp so creates still hit admission.
# KILLHUB_BASE_URL=https://killhub.pro
# Local: KILLHUB_BASE_URL=http://127.0.0.1:3000
# Optional Bearer for future auth; anonymous public demo leaves this empty.
# KILLHUB_API_TOKEN=

# --- Vultr ---
VULTR_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_API_KEY=
# Chat/text model id from GET {VULTR_INFERENCE_BASE_URL}/models (required — D25 fail-closed).
# Example: qwen3.8-flash-next
VULTR_INFERENCE_MODEL=
# Optional extras on the same Killhub subscription (D75 under D25). Pick ids from /models.
# Example embedding: qwen3-embedding-4b
VULTR_INFERENCE_EMBEDDING_MODEL=
# Vision/multimodal model for screenshot captions; empty → VULTR_INFERENCE_MODEL.
VULTR_INFERENCE_VISION_MODEL=
# When set, vuln_review drafts via POST /chat/completions/RAG against this collection id.
VULTR_RAG_COLLECTION=
# Upsert this job's finding snippets into VULTR_RAG_COLLECTION (default off).
VULTR_RAG_SEED_FINDINGS=false
# AI draft for cite-checked vuln_review; fail closed → deterministic summary (D48).
ENABLE_VULN_REVIEW_LLM=true
# Optional screenshot UI caption; never gates completion (D31). Default off.
ENABLE_SCREENSHOT_VISION=false

# --- OpenCode (trusted config only — D38; Vultr inference only — D25) ---
# Empty → explore/opencode/opencode.json (host-owned). Never point at a submitted repo.
OPENCODE_CONFIG=
OPENCODE_MODEL=

# --- Microsandbox / VX1 harness (D36, D39, D59) ---
# Empty / local = msb on PATH. Otherwise SSH target (user@host) for remote VX1.
MSB_HOST=
# Absolute path when SSH'ing (remote non-login PATH often lacks ~/.local/bin).
MSB_BIN=msb
MSB_SSH_KEY=
# Public short name (local dx) or Vultr CR pin (prod — D74), e.g.:
# MSB_DEFAULT_IMAGE=ewr.vultrcr.com/killhub/bootstrap@sha256:<digest>
MSB_DEFAULT_IMAGE=debian
MSB_DEFAULT_CPUS=2
MSB_DEFAULT_MEMORY=4Gi
MSB_NET_POLICY=
# Vultr Container Registry — host/msb pull only; never guest (D74, D19, D44).
# VULTR_CR_ENDPOINT=ewr.vultrcr.com/killhub
VULTR_CR_ENDPOINT=
VULTR_CR_ROBOT_USERNAME=
VULTR_CR_ROBOT_PASSWORD=
# When MSB_DEFAULT_IMAGE / oci_image is *.vultrcr.com, require robot creds (fail-closed).
VULTR_CR_REQUIRE_CREDS=true

# Comma-separated hostnames/IPs denied on every sandbox create (D39).
# Include the CONTROL_PLANE_PROBE_URL host so install-phase CP denial is meaningful.
# Public demo: killhub.pro (D24). Local: use whatever CP hostname you probe.
CONTROL_PLANE_DENY_HOSTS=killhub.pro
MSB_READY_TIMEOUT_SECONDS=120
MSB_AUTO_CREATE=false
DISCOVER_ON_CLAIM=false
INSTALL_ON_CLAIM=false
VERIFY_ON_CLAIM=false
SCREENSHOTS_ON_CLAIM=false
CONTAINMENT_ON_CLAIM=false
FINALIZE_ON_CLAIM=false
VULN_SCAN_OSV_URL=https://api.osv.dev/v1/querybatch
REAPER_ENABLED=true
REAPER_POLL_SECONDS=30
CANARY_STORAGE=./storage/canaries
PROFILE_STORAGE=./storage/profiles
# Known-live CP target (denied) + distinct public positive control (allowed) (D65).
# Public demo: https://killhub.pro
CONTROL_PLANE_PROBE_URL=https://killhub.pro
# Operator-owned VX1 admin address, e.g. 192.0.2.10:22
MANAGEMENT_PROBE_ADDRESS=
PUBLIC_DEMO_FIXTURES_ONLY=false
INSTALL_EGRESS_PROBE_URL=https://github.com

# --- Plane-1 pre-flight (D45) ---
PREFLIGHT_ENABLED=true
# Comma list: org/repo, org/*, or org
PREFLIGHT_DENY_REPOS=
PREFLIGHT_GITHUB_API=https://api.github.com
PREFLIGHT_TIMEOUT_SECONDS=5
PREFLIGHT_SOFT_MAX_SIZE_KB=500000
# Optional GitHub token for higher metadata rate limits (Plane 1 only).
GITHUB_TOKEN=

# --- Timeouts / admission / budgets (D40, D41) ---
JOB_TIMEOUT_SECONDS=3600
JOB_STALL_SECONDS=600
ENV_TTL_SECONDS=7200
MAX_REPAIR_ATTEMPTS=3
# Recreate a lost sandbox and re-run the pipeline this many times per job (D80; 0 = off)
MAX_SANDBOX_HEALS=1
MAX_CONCURRENT_JOBS=2
MAX_QUEUED_JOBS=8
# Soft ETA fallback for in-queue jobs when no recent terminal durations exist.
ESTIMATED_JOB_SECONDS=900
MAX_JOB_LOG_BYTES=2000000
MAX_SCREENSHOTS_PER_JOB=12
INFERENCE_BUDGET_TOKENS_PER_JOB=200000
INFERENCE_BUDGET_REJECT=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_POST_JOBS_PER_IP=10
RATE_LIMIT_POST_JOBS_GLOBAL=60
# Rolling cross-job inference budget (0 = disabled). Per-job cap above still applies.
INFERENCE_BUDGET_TOKENS_ROLLING=0
INFERENCE_BUDGET_ROLLING_WINDOW_SECONDS=3600
# Admission shared store (D71): memory (local default) | valkey (Vultr Managed Valkey).
# When valkey: set VALKEY_URL (REDIS_URL alias ok). Fail closed if Valkey is unreachable.
# Example: rediss://default:PASSWORD@HOST:16724/0  (TLS) or redis://… for non-TLS.
ADMISSION_STORE=memory
VALKEY_URL=
# REDIS_URL=

# --- Ledger / artifacts (D41, D60, D72, D73) ---
# Default local/dev SQLite. For Vultr Managed Postgres (D73), use e.g.:
# LEDGER_URL=postgresql://vultradmin:PASSWORD@HOST:PORT/defaultdb?sslmode=require
# (Plane-1-only — never inject into sandboxes.)
LEDGER_URL=sqlite:///./storage/ledger/killhub.db
# filesystem (default, local/dev) | s3 | object — Plane 1 only (D72).
STORAGE_BACKEND=filesystem
# Local staging roots (also used when STORAGE_BACKEND=filesystem).
# Legacy: SCREENSHOT_STORAGE=s3|object selects object backend with ./storage/screenshots staging.
SCREENSHOT_STORAGE=./storage/screenshots
ARTIFACT_STORAGE=./storage/artifacts
# Vultr Object Storage (S3-compatible) — required when STORAGE_BACKEND=s3|object.
# Endpoint = subscription hostname, e.g. https://ewr1.vultrobjects.com (never inject into sandboxes).
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_PREFIX=killhub
# Optional Vultr CDN Pull Zone base (D76) for feed thumbs — no trailing slash.
# OBJECT_STORAGE_CDN_BASE_URL=https://cdn-xxxxx.vultrcdn.com
OBJECT_STORAGE_CDN_BASE_URL=
# Also upload nightly SQLite snapshots when true (python -m ledger.backup --upload).
LEDGER_BACKUP_UPLOAD=false
HELPERS_ROOT=./helpers
MSB_STAGE_DIR=/tmp/killhub-stage
MAX_COPY_BYTES=32000000
MSB_EXEC_TIMEOUT_SECONDS=120

# Optional dedicated guest-network control interface and prebuilt sibling image (SETUP.md).
CONTAINMENT_GATEWAY_INTERFACE=
CONTAINMENT_SIBLING_IMAGE=
